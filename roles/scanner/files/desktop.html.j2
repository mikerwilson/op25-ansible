<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OP25 Channel Control</title>
    <link rel="stylesheet" type="text/css" href="main.css">
    <script src="main.js"></script>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #121212;
            color: #ffffff;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            transition: background-color 0.3s, color 0.3s;
        }

        .container {
            padding: 20px;
            display: flex;
            flex-direction: row;
            gap: 20px;
            height: 100vh;
        }

        .left-column, .right-column {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .iframe-container {
            flex: 1;
            width: 100%;
            border-radius: 5px;
            overflow: hidden;
            border: 1px solid #333;
        }

        .iframe-container iframe {
            width: 100%;
            height: 100%;
            border: none;
        }

        .audio-player {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: #1e1e1e;
            border-radius: 5px;
            border: 1px solid #333;
            padding: 10px 20px;
        }

        .status {
            font-size: 18px;
        }

        .button {
            padding: 10px 20px;
            background-color: #28a745;
            color: #ffffff;
            border: none;
            border-radius: 5px;
            font-size: 18px;
            cursor: pointer;
        }

        .button.playing {
            background-color: #dc3545;
        }

        .button:hover {
            opacity: 0.9;
        }

        .whitelisted-tgids, .tgid-list {
            background-color: #1e1e1e;
            padding: 20px;
            border-radius: 5px;
            border: 1px solid #333;
            overflow-y: auto;
            flex: 1;
        }

        .whitelisted-tgids h2, .tgid-list h2 {
            margin-top: 0;
        }

        .whitelisted-tgids div, .tgid-entry {
            margin-bottom: 15px;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .whitelisted-tgids a, .tgid-entry a {
            flex: 1 1 calc(50% - 10px);
            background-color: #007bff;
            color: #fff;
            padding: 15px;
            border-radius: 5px;
            text-align: center;
            text-decoration: none;
            font-size: 18px;
        }

        .whitelisted-tgids a:hover, .tgid-entry a:hover {
            background-color: #0056b3;
        }

        .scan-button {
            display: block;
            margin: 20px auto 0;
            background-color: #28a745;
            color: #fff;
            border: none;
            padding: 15px 20px;
            border-radius: 5px;
            font-size: 18px;
            cursor: pointer;
            text-align: center;
            width: 100%;
        }

        .scan-button:hover {
            background-color: #218838;
        }

        .toggle-button {
            position: fixed;
            top: 10px;
            right: 10px;
            background-color: #007bff;
            color: #fff;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
            z-index: 1000;
        }

        .toggle-button:hover {
            background-color: #0056b3;
        }

        .light-mode {
            background-color: #ffffff;
            color: #000000;
        }

        .light-mode .iframe-container, .light-mode .whitelisted-tgids, .light-mode .tgid-list, .light-mode .audio-player {
            background-color: #f9f9f9;
            border-color: #ccc;
        }

        .light-mode a {
            color: #ffffff;
        }

        .light-mode a:hover {
            color: #dddddd;
        }

        .light-mode .scan-button {
            background-color: #28a745;
            color: #ffffff !important;
        }

        .light-mode .scan-button:hover {
            background-color: #218838;
        }

        .light-mode .toggle-button {
            background-color: #007bff;
            color: #fff;
        }

        .light-mode .toggle-button:hover {
            background-color: #0056b3;
        }

        .copy-link {
            margin-top: 10px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .copy-link input {
            flex: 1;
            padding: 10px;
            font-size: 16px;
            border: 1px solid #333;
            border-radius: 5px;
            background-color: #1e1e1e;
            color: #fff;
        }

        .copy-link button {
            padding: 10px 20px;
            font-size: 16px;
            background-color: #007bff;
            color: #fff;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        .copy-link button:hover {
            background-color: #0056b3;
        }

        .copy-link label {
            font-size: 12px;
            color: #bbb;
        }
    </style>
</head>
<body>
    <button class="toggle-button" onclick="toggleTheme()">Toggle Day/Night Mode</button>
    <div class="container">
        <div class="left-column">
            <div class="iframe-container">
                <iframe src="{{ iframe_target }}" id="op25-iframe"></iframe>
            </div>
            <div class="audio-player">
                <p class="status" id="status">Status: Not playing</p>
                <p class="status" id="timer">Time Elapsed: 00:00</p>
                <button class="button" id="streamButton" onclick="toggleIcecastStream('{{ audio_stream }}')">Start Stream</button>
                <audio id="liveAudio" style="display:none;"></audio>
            </div>
            <div class="copy-link">
                <label for="audioLink">Stream URL</label>
                <input type="text" id="audioLink" value="{{ audio_stream }}" readonly>
                <button onclick="copyToClipboard()">Copy Link</button>
            </div>
        </div>
        <div class="right-column">
            <div class="whitelisted-tgids">
                <h2>Whitelisted TGIDs</h2>
                {% for tgid, name in whitelisted_tgids.items() %}
                <div>
                    <a href="#" onclick="setTGIDAndListen('{{ tgid }}')">{{ name }} ({{ tgid }})</a>
                </div>
                {% endfor %}
                <button class="scan-button" onclick="setTGIDAndListen('0')">Scan</button>
            </div>
            <div class="tgid-list">
                <h2>All Talkgroups</h2>
                {% for tgid, name in channels.items() %}
                <div class="tgid-entry">
                    <a href="#" onclick="setTGIDAndListen('{{ tgid }}')">{{ name }} ({{ tgid }})</a>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
    <script>
        let mediaSource;
        let sourceBuffer;
        const audio = document.getElementById('liveAudio');
        let timerInterval;

        async function toggleIcecastStream(url) {
            const button = document.getElementById('streamButton');
            const status = document.getElementById('status');
            const timer = document.getElementById('timer');

            if (button.classList.contains('playing')) {
                clearInterval(timerInterval);
                audio.pause();
                button.textContent = 'Start Stream';
                button.classList.remove('playing');
                status.textContent = 'Status: Not playing';
                timer.textContent = 'Time Elapsed: 00:00';
                return;
            }

            try {
                status.textContent = 'Status: Connecting...';
                mediaSource = new MediaSource();
                audio.src = URL.createObjectURL(mediaSource);

                mediaSource.addEventListener('sourceopen', async () => {
                    sourceBuffer = mediaSource.addSourceBuffer('audio/mpeg');
                    const response = await fetch(url);
                    const reader = response.body.getReader();

                    async function read() {
                        const { done, value } = await reader.read();
                        if (done) {
                            mediaSource.endOfStream();
                            return;
                        }
                        sourceBuffer.appendBuffer(value);
                        await read();
                    }
                    await read();
                });

                audio.play();
                button.textContent = 'Stop Stream';
                button.classList.add('playing');
                status.textContent = 'Status: Playing';
                startTimer(timer);
            } catch (error) {
                status.textContent = 'Status: Error - ' + error.message;
                console.error('Error playing Icecast stream:', error);
            }
        }

        function startTimer(timerElement) {
            let seconds = 0;
            timerInterval = setInterval(() => {
                seconds++;
                const minutes = String(Math.floor(seconds / 60)).padStart(2, '0');
                const secs = String(seconds % 60).padStart(2, '0');
                timerElement.textContent = `Time Elapsed: ${minutes}:${secs}`;
            }, 1000);
        }

        function setTGIDAndListen(tgid) {
            const originalPrompt = window.prompt;
            window.prompt = function() { return tgid; };
            f_scan_button('goto');
            window.prompt = originalPrompt;
        }

        function toggleTheme() {
            document.body.classList.toggle('light-mode');
        }

        function copyToClipboard() {
            const audioLink = document.getElementById('audioLink');
            audioLink.select();
            audioLink.setSelectionRange(0, 99999);
            navigator.clipboard.writeText(audioLink.value);
            alert('Audio stream link copied to clipboard!');
        }

        const prefersDarkScheme = window.matchMedia("(prefers-color-scheme: dark)");
        if (prefersDarkScheme.matches) {
            document.body.classList.remove('light-mode');
        } else {
            document.body.classList.add('light-mode');
        }
    </script>
</body>
</html>