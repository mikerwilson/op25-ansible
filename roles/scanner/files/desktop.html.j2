<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OP25 Channel Control</title>
    <link rel="stylesheet" type="text/css" href="main.css">
    <script src="main.js"></script>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #121212;
            color: #ffffff;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            transition: background-color 0.3s, color 0.3s;
        }
        .page-container {
            padding: 20px;
            max-width: 1200px;
            margin: 20px auto;
            background-color: #1e1e1e;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 20px;
            background-color: #333;
            border-radius: 8px;
            margin-bottom: 20px;
        }
        .header h1 {
            color: #fff;
            font-size: 24px;
        }
        .day-night-toggle {
            background-color: #007bff;
            color: #fff;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
        }
        .day-night-toggle:hover {
            background-color: #0056b3;
        }
        .main-content {
            display: flex;
            gap: 20px;
        }
        .op25-iframe {
            flex: 2;
            height: 300px;
            background-color: #121212;
            border-radius: 8px;
            overflow: hidden;
            position: sticky;
            top: 20px;
        }
        .op25-iframe iframe {
            width: 100%;
            height: 100%;
            border: none;
        }
        .audio-player {
            flex: 1;
            background-color: #1e1e1e;
            padding: 15px;
            border-radius: 8px;
            text-align: center;
        }
        .audio-player button {
            padding: 10px 20px;
            background-color: #28a745;
            color: #ffffff;
            border: none;
            border-radius: 5px;
            font-size: 18px;
            cursor: pointer;
        }
        .audio-player button.playing {
            background-color: #dc3545;
        }
        .audio-player button:hover {
            opacity: 0.9;
        }
        .favorites-scanlist {
            background-color: #1e1e1e;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
        }
        .favorites-scanlist h2 {
            font-size: 20px;
            margin-bottom: 10px;
        }
        .favorites-scanlist div {
            margin-bottom: 10px;
        }
        .favorites-scanlist a {
            display: block;
            padding: 10px;
            background-color: #007bff;
            color: #fff;
            text-align: center;
            border-radius: 5px;
            text-decoration: none;
            font-size: 16px;
        }
        .favorites-scanlist a:hover {
            background-color: #0056b3;
        }
        .favorites-scanlist-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }
        .light-mode {
            background-color: #ffffff;
            color: #000000;
        }
        .light-mode .favorites-scanlist {
            background-color: #f9f9f9;
            border: 1px solid #ccc;
        }
        .light-mode .audio-player {
            background-color: #f9f9f9;
            border: 1px solid #ccc;
        }
        .light-mode .day-night-toggle {
            background-color: #0056b3;
            color: #ffffff;
        }
        .light-mode .day-night-toggle:hover {
            background-color: #004494;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>OP25 Channel Control</h1>
        <button class="toggle-button" id="themeToggleButton">Day/Night Mode</button>
    </div>
    <div class="container">
        <div class="main-content">
            <!-- Iframe Section -->
            <div class="iframe-container">
                <iframe src="{{ iframe_target | default('about:blank') }}" id="op25-iframe"></iframe>
            </div>
            <!-- Audio Player Section -->
            <div class="audio-player">
                <p class="status" id="status">Status: Not playing</p>
                <p class="status" id="timer">Time Elapsed: 00:00</p>
                <button class="stream-start-stop" id="streamButton" onclick="toggleIcecastStream('{{ audio_stream | default('') }}')">Start Stream</button>
                <audio id="liveAudio" style="display:none;"></audio>
            </div>
        </div>

        <!-- Scan Button -->
        <button class="scan-button" onclick="setTGIDAndListen('0')">Scan</button>

        <!-- Sections Wrapper -->
        <div class="grid-layout">
            <!-- Whitelisted TGIDs Section -->
            {% if whitelisted_tgids | default({}) %}
            <div class="section">
                <h2>Scan List</h2>
                {% for tgid, name in whitelisted_tgids.items() %}
                <div>
                    <a href="#" onclick="setTGIDAndListen('{{ tgid }}')">{{ name }}</br>({{ tgid }})</a>
                </div>
                {% endfor %}
            </div>
            {% endif %}

            <!-- Favorites Section -->
            {% if favorites_tgids | default({}) %}
            <div class="section">
                <h2>Favorites</h2>
                {% for tgid, name in favorites_tgids.items() %}
                <div>
                    <a href="#" onclick="setTGIDAndListen('{{ tgid }}')">{{ name }}</br>({{ tgid }})</a>
                </div>
                {% endfor %}
            </div>
            {% endif %}
        </div>

        <!-- All Talkgroups Section -->
        <div class="section">
            <h2>All Talkgroups</h2>
            {% for tgid, name in channels.items() %}
            <div class="tgid-entry">
                <a href="#" onclick="setTGIDAndListen('{{ tgid }}')">{{ name }} ({{ tgid }})</a>
            </div>
            {% endfor %}
        </div>
    </div>

    <script>
        let mediaSource;
        let sourceBuffer;
        const audio = document.getElementById('liveAudio');
        let timerInterval;

        async function toggleIcecastStream(url) {
            const button = document.getElementById('streamButton');
            const status = document.getElementById('status');
            const timer = document.getElementById('timer');

            if (button.classList.contains('playing')) {
                clearInterval(timerInterval);
                audio.pause();
                button.textContent = 'Start Stream';
                button.classList.remove('playing');
                status.textContent = 'Status: Not playing';
                timer.textContent = 'Time Elapsed: 00:00';
                return;
            }

            try {
                status.textContent = 'Status: Connecting...';
                mediaSource = new MediaSource();
                audio.src = URL.createObjectURL(mediaSource);

                mediaSource.addEventListener('sourceopen', async () => {
                    sourceBuffer = mediaSource.addSourceBuffer('audio/mpeg');
                    const response = await fetch(url);
                    const reader = response.body.getReader();

                    async function read() {
                        const { done, value } = await reader.read();
                        if (done) {
                            mediaSource.endOfStream();
                            return;
                        }
                        sourceBuffer.appendBuffer(value);
                        await read();
                    }
                    await read();
                });

                audio.play();
                button.textContent = 'Stop Stream';
                button.classList.add('playing');
                status.textContent = 'Status: Playing';
                startTimer(timer);
            } catch (error) {
                status.textContent = 'Status: Error - ' + error.message;
                console.error('Error playing Icecast stream:', error);
            }
        }

        function startTimer(timerElement) {
            let seconds = 0;
            timerInterval = setInterval(() => {
                seconds++;
                const minutes = String(Math.floor(seconds / 60)).padStart(2, '0');
                const secs = String(seconds % 60).padStart(2, '0');
                timerElement.textContent = `Time Elapsed: ${minutes}:${secs}`;
            }, 1000);
        }

        function setTGIDAndListen(tgid) {
            const originalPrompt = window.prompt;
            window.prompt = function() { return tgid; };
            f_scan_button('goto');
            window.prompt = originalPrompt;
        }

        function toggleTheme() {
            document.body.classList.toggle('light-mode');
            localStorage.setItem('theme', document.body.classList.contains('light-mode') ? 'light' : 'dark');
        }

        // Automatically set theme based on system preference or saved setting
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme) {
            document.body.classList.toggle('light-mode', savedTheme === 'light');
        } else {
            const prefersDarkScheme = window.matchMedia("(prefers-color-scheme: dark)");
            document.body.classList.toggle('light-mode', !prefersDarkScheme.matches);
        }

        // Ensure the button label matches the current theme
        document.getElementById('themeToggleButton').textContent = document.body.classList.contains('light-mode') ? 'Day/Night Mode' : 'Day/Night Mode';
    </script>
</body>
</html>