<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OP25 Channel Control</title>
    <link rel="stylesheet" type="text/css" href="main.css">
    <script src="main.js"></script>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #121212;
            color: #ffffff;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            transition: background-color 0.3s, color 0.3s;
        }
        .page-container {
            padding: 7px;
            display: flex;
            flex-direction: column;
            gap: 0px;
            max-width: 858px;
            width: 100%; /* Ensures it expands to the max width */
            margin: 0 auto; /* Centers the container */
            box-sizing: border-box; /* Ensures padding doesn’t reduce width */
        }
        .op25-iframe {
            width: 100%;
            height: 230px;
            margin-bottom: 3px;
            position: sticky;
            top: 0;
            z-index: 100;
            background-color: #121212;
        }
        .op25-iframe iframe {
            width: 100%;
            height: 100%;
            border: none;
            box-sizing: border-box;
        }

        .scanbutton {
            border-color: black;
            color: white;
            padding: 10px 10px;
            text-decoration: none;
            margin: 4px 2px;
            cursor: pointer;
            width: 100%;
            font-size: 22px;
            font-weight: bold;
            background: #669999;
        }
        .scanbutton:hover {
            background-color: #4d7373;
        }

        .audio-player {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: #1e1e1e;
            border-radius: 5px;
            border: 1px solid #333;
            padding: 5px 10px;
        }
        .status {
            font-size: 18px;
        }
        .stream-start-stop {
            padding: 12px 24px;
            background-color: #1d7831;
            color: #ffffff;
            border: none;
            border-radius: 5px;
            font-size: 20px;
            cursor: pointer;
            padding: 21px;
        }
        .stream-start-stop.playing {
            background-color: #9a2631;
        }
        .stream-start-stop:hover {
            opacity: 0.9;
        }

        .light-mode .stream-start-stop {
            background-color: #35cd59;
        }

        .light-mode .stream-start-stop.playing {
            background-color: #dc3545;
        }

        .favorites-scanlist {
            background-color: #1e1e1e;
            padding: 5px;
            border-radius: 5px;
            border: 1px solid #333;
            overflow-y: auto;
        }
        .favorites-scanlist h2 {
            margin-top: 0;
            font-size: 18px;
        }
        .favorites-scanlist div {
            margin-bottom: 5px;
        }
        .favorites-scanlist button {
            display: block;
            width: 100%;
            background-color: #053467;
            color: #fff;
            padding: 28px 10px;
            border-radius: 5px;
            text-align: center;
            border: none;
            font-size: 22px;
            cursor: pointer;
            {#font-weight: bold;#}

        }
        .favorites-scanlist button:hover {
            background-color: #007bff;
        }

        .day-night-toggle {
            position: fixed;
            top: 14px;
            right: 10px;
            background-color: #007bff;
            color: #fff;
            border: none;
            padding: 10px 24px;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
            z-index: 1000;
        }
        .day-night-toggle:hover {
            background-color: #0056b3;
        }
        .light-mode {
            background-color: #ffffff;
            color: #000000;
        }
        .light-mode .op25-iframe, .light-mode .favorites-scanlist, .light-mode .audio-player, .light-mode .channel-list, .light-mode .favorites-scanlist-grid {
            background-color: #f9f9f9;
            border-color: #ccc;
        }
        .light-mode button {
            color: #ffffff;
            background-color: #007bff;
        }
        .light-mode button:hover {
            color: #dddddd;
        }
        .light-mode .scanbutton {
            background-color: #669999;
            color: #ffffff !important;
        }
        .light-mode .scanbutton:hover {
            background-color: #3c5a5a;
        }
        .light-mode .day-night-toggle {
            background-color: #007bff;
            color: #fff;
        }
        .light-mode .day-night-toggle:hover {
            background-color: #0056b3;
        }
        .favorites-scanlist-grid {
            margin-top: 15px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 5px;
        }
        .all-talkgroups {
            background-color: #053467;
            color: white;
            cursor: pointer;
            padding: 10px 20px;
            margin-top: 20px;
            border: none;
            border-radius: 5px;
            text-align: center;
            font-size: 18px;
            outline: none;
            transition: background-color 0.3s;
        }
        .all-talkgroups:hover {
            background-color: #007bff;
        }
        .channel-list {
            padding: 0 20px;
            display: none;
            overflow: hidden;
            background-color: #1e1e1e;
            border-radius: 5px;
            border: 1px solid #333;
            margin-top: 5px;
        }
        .channel-list .favorites-scanlist-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 7px;
            justify-items: center;
        }
        .channel-list button {
            width: 240px;
            padding: 12px 24px;
            background-color: #053467;
            color: #fff;
            border: none;
            border-radius: 5px;
            font-size: 20px;
            cursor: pointer;
        }
        .channel-list button:hover {
            background-color: #007bff;
        }

        .light-mode .channel-list button {
            background-color: #007bff;
        }

        .light-mode .channel-list button:hover {
            background-color: #0056b3;
        }


    </style>
</head>
<body>
    <button class="day-night-toggle" onclick="toggleTheme()">Day/Night<br>Mode</button>
    <div class="page-container">
        <!-- Iframe Section -->
        <div class="op25-iframe">
            <iframe src="{{ iframe_target }}" id="op25-iframe" scrolling="no"></iframe>
        </div>

        <!-- Audio Player Section -->
        <div class="audio-player">
            <p class="status" id="status">Status: Not playing</p>
            <p class="status" id="timer">--:--</p>
            <button class="stream-start-stop" id="streamButton" onclick="toggleIcecastStream('{{ audio_stream }}')">Start Stream</button>
            <audio id="liveAudio" style="display:none;"></audio>
        </div>

        <!-- Scan Button -->
        <button class="scanbutton" onclick="setTGIDAndListen('0')">Scan</button>
        <div class="favorites-scanlist-grid">
            <!-- Favorites Section -->
            {% if favorites_tgids | default({}) %}
            <div class="favorites-scanlist">
                <h2>Favorites</h2>
                {% for tgid, name in favorites_tgids.items() %}
                <div>
                    <button onclick="setTGIDAndListen('{{ tgid }}')">{{ name }}</button>
                </div>
                {% endfor %}
            </div>
            {% endif %}

            <!-- Whitelisted TGIDs Section -->
            {% if whitelisted_tgids | default({}) %}
            <div class="favorites-scanlist">
                <h2>Scan List</h2>
                {% for tgid, name in whitelisted_tgids.items() %}
                <div>
                    <button onclick="setTGIDAndListen('{{ tgid }}')">{{ name }}</button>
                </div>
                {% endfor %}
            </div>
            {% endif %}
        </div>

        <!-- All Talkgroups Section -->
        <button class="all-talkgroups">All Talkgroups</button>
        <div class="channel-list">
            <div class="favorites-scanlist-grid">
                {% for tgid, name in channels.items() %}
                <div class="tgid-entry">
                    <button onclick="setTGIDAndListen('{{ tgid }}')">{{ name }}<br>({{ tgid }})</button>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <script>
        let mediaSource;
        let sourceBuffer;
        const audio = document.getElementById('liveAudio');
        let timerInterval;

        async function toggleIcecastStream(url) {
            const button = document.getElementById('streamButton');
            const status = document.getElementById('status');
            const timer = document.getElementById('timer');

            if (button.classList.contains('playing')) {
                clearInterval(timerInterval);
                audio.pause();
                button.textContent = 'Start Stream';
                button.classList.remove('playing');
                status.textContent = 'Status: Not playing';
                timer.textContent = '--:--';
                return;
            }

            try {
                status.textContent = 'Status: Connecting...';
                mediaSource = new MediaSource();
                audio.src = URL.createObjectURL(mediaSource);

                mediaSource.addEventListener('sourceopen', async () => {
                    sourceBuffer = mediaSource.addSourceBuffer('audio/mpeg');
                    const response = await fetch(url);
                    const reader = response.body.getReader();

                    async function read() {
                        const { done, value } = await reader.read();
                        if (done) {
                            mediaSource.endOfStream();
                            return;
                        }
                        sourceBuffer.appendBuffer(value);
                        await read();
                    }
                    await read();
                });

                audio.play();
                button.textContent = 'Stop Stream';
                button.classList.add('playing');
                status.textContent = 'Status: Playing';
                startTimer(timer);
            } catch (error) {
                status.textContent = 'Status: Error - ' + error.message;
                console.error('Error playing Icecast stream:', error);
            }
        }

        function startTimer(timerElement) {
            let seconds = 0;
            timerInterval = setInterval(() => {
                seconds++;
                const minutes = String(Math.floor(seconds / 60)).padStart(2, '0');
                const secs = String(seconds % 60).padStart(2, '0');
                timerElement.textContent = `${minutes}:${secs}`;
            }, 1000);
        }

        function setTGIDAndListen(tgid) {
            const originalPrompt = window.prompt;
            window.prompt = function() { return tgid; };
            f_scan_button('goto');
            window.prompt = originalPrompt;
        }

        function toggleTheme() {
            document.body.classList.toggle('light-mode');
        }

        // Automatically set theme based on system preference
        const prefersDarkScheme = window.matchMedia("(prefers-color-scheme: dark)");
        if (prefersDarkScheme.matches) {
            document.body.classList.remove('light-mode');
        } else {
            document.body.classList.add('light-mode');
        }

        // Collapsible Section Logic
        const collapsible = document.querySelector('.all-talkgroups');
        const content = document.querySelector('.channel-list');

        collapsible.addEventListener('click', function() {
            this.classList.toggle('active');
            content.style.display = content.style.display === 'block' ? 'none' : 'block';
        });
    </script>
</body>
</html>
