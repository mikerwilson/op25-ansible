<script>
    // Audio Player stuff
    // Configurable lag threshold (in seconds)
    const SHOW_LAG = true;
    const LAG_THRESHOLD = 3;
    const DEFAULT_GAIN = {{ audio_player_gain }}; // Default audio gain (2.0 = double the normal volume)


    let mediaSource;
    let sourceBuffer;
    const audio = document.getElementById('liveAudio');
    const streamUrlInput = document.getElementById('streamUrl');
    const button = document.getElementById('streamButton');
    const status = document.getElementById('status');
    const timer = document.getElementById('timer');
    let timerInterval;
    let streamReader;
    let connected = false;


    // Web Audio API variables
    let audioContext = null;
    let gainNode = null;
    let audioSource = null;

    function setupAudioGain() {
        if (!audioContext) {
            // Initialize Web Audio API only after user interaction
            audioContext = new AudioContext();
            gainNode = audioContext.createGain();
            audioSource = audioContext.createMediaElementSource(audio);

            // Connect the nodes
            audioSource.connect(gainNode);
            gainNode.connect(audioContext.destination);

            // Restore saved gain value or use the default
            const savedGain = localStorage.getItem('audioGain');
            const initialGain = savedGain ? parseFloat(savedGain) : DEFAULT_GAIN;
            gainNode.gain.value = initialGain;

            // Update slider position to reflect the current gain
            gainSlider.value = initialGain;

            // Update gain dynamically and save to localStorage
            gainSlider.addEventListener('input', () => {
                const newGain = parseFloat(gainSlider.value);
                gainNode.gain.value = newGain;
                localStorage.setItem('audioGain', newGain);
            });
        }
    }

    async function toggleIcecastStream(url) {
        const streamUrl = url;

        if (!streamUrl) {
            alert('Invalid stream URL.  Please check config.');
            return;
        }

        if (button.classList.contains('playing')) {
            stopStream();
            return;
        }

        // Initialize AudioContext and setup gain after user interaction
        setupAudioGain();

        try {
            status.textContent = 'Status: Connecting...\n'; // Add single newline after status
            mediaSource = new MediaSource();
            audio.src = URL.createObjectURL(mediaSource);

            mediaSource.addEventListener('sourceopen', async () => {
                try {
                    sourceBuffer = mediaSource.addSourceBuffer('audio/mpeg');
                    const response = await fetch(streamUrl);
                    if (!response.ok) throw new Error('Failed to connect to the stream.');
                    streamReader = response.body.getReader();
                    connected = true;
                    status.textContent = 'Status: Connected\n'; // Add single newline after status
                    startStream();
                } catch (err) {
                    handleError(err.message || 'Unknown error while connecting to stream.');
                }
            });

        } catch (error) {
            handleError(error.message || 'Error initializing MediaSource.');
        }
    }

    async function readStream() {
        try {
            while (connected) {
                const { done, value } = await streamReader.read();
                if (done) {
                    stopStream('Stream disconnected.');
                    break;
                }
                sourceBuffer.appendBuffer(value);
            }
        } catch (err) {
            handleError('Error reading stream data.');
        }
    }

    function stopStream(message = 'Stream stopped.') {
        clearInterval(timerInterval); // Clear timer interval
        clearInterval(lagInterval); // Clear lag interval
        connected = false;

        if (streamReader) streamReader.cancel();
        if (audio) audio.pause();
        button.textContent = 'Start Stream';
        button.classList.remove('playing');
        status.textContent = `Status: ${message}`;

        // Clear lag text
        const lagElement = document.getElementById('lag');
        if (lagElement) {
            lagElement.textContent = '\u00A0'; // Reset lag element to a non-breaking space
        }
    }

    function handleError(message) {
        stopStream(`Error: ${message}`);
        console.error(message);
    }

    async function startStream() {
        button.textContent = 'Stop Stream';
        button.classList.add('playing');
        audio.play();
        startTimer();
        trackLag(); // Start tracking lag if SHOW_LAG is true
        readStream();
    }

    function startTimer() {
        let seconds = 0;
        timerInterval = setInterval(() => {
            seconds++;
            const minutes = String(Math.floor(seconds / 60)).padStart(2, '0');
            const secs = String(seconds % 60).padStart(2, '0');
            timer.textContent = `${minutes}:${secs}`;
        }, 1000);
    }

    function trackLag() {
        if (!SHOW_LAG) return; // Exit if lag tracking is disabled

        const lagElement = document.getElementById('lag'); // Reference the existing lag element

        lagInterval = setInterval(() => {
            if (audio.buffered.length > 0) {
                // Calculate lag as the difference between the end of the buffer and the current playback position
                const bufferedEnd = audio.buffered.end(audio.buffered.length - 1);
                const lag = bufferedEnd - audio.currentTime;

                // Ensure status displays correctly
                status.textContent = `Status: Connected`;

                // Update lag message
                lagElement.textContent = `Lag: ${lag.toFixed(2)} secs`;

                // Automatically jump to end if lag exceeds threshold
                if (lag > LAG_THRESHOLD) {
                    audio.currentTime = bufferedEnd;
                    lagElement.textContent += ' (Jumped to live)';
                }
            } else if (connected) {
                status.textContent = `Status: Connected`;
                lagElement.textContent = 'Lag: Calculating...';
            }
        }, 1000); // Update every second
    }
    
    function setTGIDAndListen(tgid) {
        const originalPrompt = window.prompt;
        window.prompt = function() { return tgid; };
        f_scan_button('goto');
        window.prompt = originalPrompt;
    }

    function whitelistTGID(tgid) {
        const originalPrompt = window.prompt;
        window.prompt = function() { return tgid; };
        f_scan_button('whitelist');
        window.prompt = originalPrompt;
    }

    function blacklistTGID(tgid) {
        const originalPrompt = window.prompt;
        window.prompt = function() { return tgid; };
        f_scan_button('lockout');
        window.prompt = originalPrompt;
    }

    function toggleTheme() {
        document.body.classList.toggle('light-mode');
    }

    // Automatically set theme based on system preference
    const prefersDarkScheme = window.matchMedia("(prefers-color-scheme: dark)");
    if (prefersDarkScheme.matches) {
        document.body.classList.remove('light-mode');
    } else {
        document.body.classList.add('light-mode');
    }

    // Collapsible Section Logic
    const collapsible = document.querySelector('.all-talkgroups');
    const content = document.querySelector('.channel-list');

    collapsible.addEventListener('click', function() {
        this.classList.toggle('active');
        content.classList.toggle('active');
    });

    const searchInput = document.getElementById('searchTalkgroups');
    const talkgroupList = document.getElementById('talkgroupList');
    searchInput.addEventListener('input', function () {
        const filter = searchInput.value.toLowerCase();
        const entries = talkgroupList.getElementsByClassName('tgid-entry');

        for (let i = 0; i < entries.length; i++) {
            const entry = entries[i];
            const text = entry.textContent || entry.innerText; // Get all visible text, including multi-line content

            // Check if the text includes the filter (case insensitive)
            entry.style.display = text.toLowerCase().includes(filter) ? '' : 'none';
        }
    });

    // Detect external play, pause, and end events
    audio.addEventListener('play', () => {
        updateUIPlaying();
        if (isJumpToLiveEdgeEnabled) {
            startJumpToLiveEdgeInterval();
        }
    });

    audio.addEventListener('pause', () => {
        updateUIStopped();
        clearInterval(jumpToLiveEdgeInterval);
    });

    audio.addEventListener('ended', () => {
        updateUIStopped();
        clearInterval(jumpToLiveEdgeInterval);
    });

    function updateUIPlaying() {
        const button = document.getElementById('streamButton');
        const status = document.getElementById('status');
        const timer = document.getElementById('timer');

        if (!button.classList.contains('playing')) {
            button.textContent = 'Stop Stream';
            button.classList.add('playing');
            status.textContent = 'Status: Playing';
            startTimer(timer);
        }
    }

    function updateUIStopped() {
        const button = document.getElementById('streamButton');
        const status = document.getElementById('status');
        const timer = document.getElementById('timer');

        clearInterval(timerInterval);
        button.textContent = 'Start Stream';
        button.classList.remove('playing');
        status.textContent = 'Status: Not playing';
        timer.textContent = '--:--';
    }

    // Jump to the live edge of the buffered audio
    function jumpToLiveEdge() {
        if (audio.buffered.length > 0) {
            const liveEdge = audio.buffered.end(audio.buffered.length - 1);
            if (audio.currentTime < liveEdge - 1) {
                audio.currentTime = liveEdge - 0.5;
                console.log('Jumped to live edge:', liveEdge);
            }
        }
    }

    // Toggle the jump to live edge feature
    function toggleJumpToLiveEdge() {
        isJumpToLiveEdgeEnabled = !isJumpToLiveEdgeEnabled;
        if (isJumpToLiveEdgeEnabled) {
            startJumpToLiveEdgeInterval();
        } else {
            clearInterval(jumpToLiveEdgeInterval);
        }
        console.log('Jump to live edge:', isJumpToLiveEdgeEnabled ? 'Enabled' : 'Disabled');
    }

    // Start an interval to run jumpToLiveEdge with configurable time
    function startJumpToLiveEdgeInterval() {
        clearInterval(jumpToLiveEdgeInterval);
        jumpToLiveEdgeInterval = setInterval(jumpToLiveEdge, jumpIntervalTime);
    }

    // Function to update the interval time dynamically
    function setJumpIntervalTime(seconds) {
        jumpIntervalTime = seconds * 1000;
        console.log(`Jump to live edge interval set to ${seconds} seconds.`);
        if (isJumpToLiveEdgeEnabled) {
            startJumpToLiveEdgeInterval();
        }
    }

    if (typeof do_onload !== "function") {
        function do_onload() {
            console.log("Fallback: Page Loaded");
        }
    }
</script>
</body>
</html>
